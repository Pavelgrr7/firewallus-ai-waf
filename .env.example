# Database credentials
POSTGRES_USER=myuser
POSTGRES_PASSWORD=secret

# Admin credentials
DEFAULT_ADMIN_USERNAME=some_admin_login
DEFAULT_ADMIN_PASSWORD=your_password

JWT_SECRET=your_strong_random_secret_here

# Containers credentials
DEFAULT_KAFKA=kafka:29092

DEFAULT_REDIS_HOST=redis
DEFAULT_REDIS_PORT=6379

# Rate limiting redis
DEFAULT_RATELIMIT_REQUESTS=2000
DEFAULT_RATELIMIT_WINDOW=60

SEED_DEFAULT_RULES=true

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Custom Telegram API URL (e.g. https://api.telegram-proxy.org if blocked)
TELEGRAM_API_URL=https://api.telegram.org

# Proxy settings (e.g., http://host.docker.internal:7890 if using a local VPN/proxy)
# HTTP_PROXY=
# HTTPS_PROXY=

